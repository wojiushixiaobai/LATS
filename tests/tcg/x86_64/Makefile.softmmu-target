#
# x86 system tests
#
# This currently builds only for i386. The common C code is built
# with standard compiler flags however so we can support both by
# adding additional boot files for x86_64.
#

I386_SYSTEM_SRC=$(SRC_PATH)/tests/tcg/i386/system
X64_SYSTEM_SRC=$(SRC_PATH)/tests/tcg/x86_64/system

# These objects provide the basic boot code and helper functions for all tests
CRT_OBJS=boot.o

CRT_PATH=$(X64_SYSTEM_SRC)
LINK_SCRIPT=$(X64_SYSTEM_SRC)/kernel.ld
LDFLAGS=-Wl,-T$(LINK_SCRIPT) -Wl,-melf_x86_64
CFLAGS+=-nostdlib -ggdb -O0 $(MINILIB_INC)
LDFLAGS+=-static -nostdlib $(CRT_OBJS) $(MINILIB_OBJS) -lgcc

TESTS+=$(MULTIARCH_TESTS)
TESTS+=xstate
EXTRA_RUNS+=$(MULTIARCH_RUNS)

# building head blobs
.PRECIOUS: $(CRT_OBJS)

%.o: $(CRT_PATH)/%.S
	$(CC) $(CFLAGS) $(EXTRA_CFLAGS) -c $< -o $@

xstate avx-native-faults: %: $(CRT_PATH)/%.S $(LINK_SCRIPT) $(CRT_OBJS)
	$(CC) $(CFLAGS) $(EXTRA_CFLAGS) $< -o $@ $(LDFLAGS)

XSTATE_CPU = Penryn,+xsave,+xsaveopt,+pclmulqdq,+aes,+rdrand,+rdseed,+popcnt,enforce
XSTATE_HAMT = 0
ifeq ($(CONFIG_LATX_TCG_MODE),y)
XSTATE_CPU := $(XSTATE_CPU),+avx,+avx2
endif

run-xstate run-xstate-native-avx: xstate
run-avx-native-faults: avx-native-faults
run-xstate run-xstate-native-avx run-avx-native-faults:
	$(call run-test, $<, $(QEMU) -L $(SRC_PATH)/pc-bios \
		-machine pc -nodefaults -display none -no-reboot \
		-latx select$(COMMA)hamt=$(XSTATE_HAMT)$(COMMA)aotsys=0$(COMMA)tumode=off \
		-cpu $(XSTATE_CPU) \
		-device isa-debug-exit$(COMMA)iobase=0xf4$(COMMA)iosize=0x4 \
		-kernel $<; test $$? -eq 33)

# Exercise the implemented subset without changing normal CPU discovery.
run-xstate-native-avx run-avx-native-faults: XSTATE_CPU = Penryn,+xsave,+xsaveopt,+pclmulqdq,+aes,+rdrand,+rdseed,+popcnt,+avx,+avx2,x-force-features=on

# Build and link the tests
%: %.c $(LINK_SCRIPT) $(CRT_OBJS) $(MINILIB_OBJS)
	$(CC) $(CFLAGS) $(EXTRA_CFLAGS) $< -o $@ $(LDFLAGS)

memory: CFLAGS+=-DCHECK_UNALIGNED=1

# Running
QEMU_OPTS+=-device isa-debugcon,chardev=output -device isa-debug-exit,iobase=0xf4,iosize=0x4 -kernel
